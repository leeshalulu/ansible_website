<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ server_title }}</title>
    <style>
        body { font-family: sans-serif; margin: 40px; background: #f4f6f8; color: #333; }
        .card { background: #fff; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); max-width: 600px; }
        h1 { color: #0066cc; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td { padding: 8px 4px; border-bottom: 1px solid #eee; }
        td.label { font-weight: bold; width: 40%; }
    </style>
</head>
<body>
    <div class="card">
        <h1>{{ server_title }}</h1>
        <p>Managed by <strong>{{ owner_name }}</strong></p>
        
        <table>
            <tr>
                <td class="label">Hostname:</td>
                <td>{{ ansible_facts['nodename'] }}</td>
            </tr>
            <tr>
                <td class="label">OS Distribution:</td>
                <td>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</td>
            </tr>
            <tr>
                <td class="label">Private IP:</td>
                <td>{{ ansible_facts['default_ipv4']['address'] | default(ansible_host) }}</td>
            </tr>
        </table>
    </div>
</body>
</html>
